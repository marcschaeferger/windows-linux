[Unit]
Description=Pangolin client background service
Documentation=https://docs.pangolin.net
# The daemon only listens on its socket; olm handles connectivity. Waiting for
# network-online.target delayed it by up to a minute where Wi-Fi comes up late,
# so a UI started at login by autostart found no daemon.
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/pangolin-client --daemon
Restart=on-failure
RestartSec=2
# SIGTERM goes to the daemon only, which stops each tunnel cleanly so DNS and
# routes are restored; anything left is killed when the timeout runs out.
KillMode=mixed
TimeoutStopSec=45
RuntimeDirectory=pangolin-client
RuntimeDirectoryMode=0755
StateDirectory=pangolin-client
StateDirectoryMode=0700
LogsDirectory=pangolin-client
# Only root reads the daemon log; the Logs tab gets it through the daemon.
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
